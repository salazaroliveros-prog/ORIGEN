{
  "name": "constructerp-guatemala",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "build:analyze": "ANALYZE=true next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,scss}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css,scss}\"",
    "seed:demo": "node scripts/seed-demo.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "test:emulator": "firebase emulators:exec --project demo-origen-e2e --only auth,firestore \"vitest run --config vitest.emulator.config.ts\"",
    "test:e2e:emulator": "cross-env NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-origen-e2e NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-origen-e2e.firebaseapp.com NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:demo     NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1:8081 NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 firebase emulators:exec --project demo-origen-e2e --only auth,firestore \"playwright test e2e/system-crud.spec.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "pwa:generate-icons": "node scripts/generate-pwa-icons.js",
    "pwa:validate-manifest": "node scripts/pwa-manifest-validator.js",
    "pwa:generate-sw": "node scripts/generate-service-worker.js",
    "images:optimize": "node scripts/optimize-images.js",
    "deps:check": "node scripts/check-dependencies.js",
    "prepare": "node -e \"console.log('skipping husky install')\""
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@rollup/wasm-node": "^4.66.0",
    "ai": "^7.0.153",
    "canvg": "4.0.3",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "dompurify": "3.4.17",
    "exceljs": "^4.4.0",
    "firebase": "12.19.0",
    "firebase-admin": "14.5.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lightningcss": "1.33.0",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-dropzone": "^20.1.4",
    "react-hot-toast": "^2.6.1",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@next/bundle-analyzer": "^15.4.9",
    "@playwright/test": "1.65.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/d3": "^7.4.3",
    "@types/jest": "30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "autoprefixer": "10.4.21",
    "chromium": "3.2171.3008",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "^15.5.28",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.6.0",
    "playwright": "1.65.0",
    "postcss": "8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "pwa-asset-generator": "^8.1.7",
    "sharp": "^0.35.5",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "3.4.19",
    "tw-animate-css": "1.4.0",
    "typescript": "5.8.2",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "wait-on": "9.5.1"
  },
  "optionalDependencies": {
    "@next/swc-win32-x64-msvc": "15.4.9"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
