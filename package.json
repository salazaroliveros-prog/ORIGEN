{
  "name": "constructerp-guatemala",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "prebuild": "node -e \"const fs=require('node:fs');fs.rmSync('.next',{recursive:true,force:true});fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "next build && node -e \"const fs=require('node:fs'),path=require('node:path');fs.mkdirSync('.next/standalone/.next',{recursive:true});fs.cpSync('.next/static','.next/standalone/.next/static',{recursive:true});fs.cpSync('public','.next/standalone/public',{recursive:true});fs.mkdirSync('dist',{recursive:true});for(const entry of fs.readdirSync('.next'))fs.cpSync(path.join('.next',entry),path.join('dist',entry),{recursive:true});fs.cpSync('public','dist/public',{recursive:true})\"",
    "build:analyze": "ANALYZE=true next build",
    "start": "node server.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,scss}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css,scss}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "test:emulator": "firebase emulators:exec --project demo-origen-e2e --only auth,firestore \"vitest run --config vitest.emulator.config.ts\"",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "pwa:generate-icons": "node scripts/generate-pwa-icons.js",
    "pwa:validate-manifest": "node scripts/pwa-manifest-validator.js",
    "pwa:generate-sw": "node scripts/generate-service-worker.js",
    "images:optimize": "node scripts/optimize-images.js",
    "deps:check": "node scripts/check-dependencies.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "ai": "^7.0.153",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "exceljs": "^4.4.0",
    "firebase": "^12.19.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-dropzone": "^20.1.4",
    "react-hot-toast": "^2.6.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@next/bundle-analyzer": "^16.4.3",
    "@tailwindcss/postcss": "4.1.11",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "pwa-asset-generator": "^8.1.7",
    "sharp": "^0.35.5",
    "tailwindcss": "4.1.11",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "postcss": "^8.5.23",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
