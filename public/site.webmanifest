{
  "name": "ConstructERP Guatemala",
  "short_name": "ConstructERP",
  "description": "ERP integral para arquitectos y constructoras en Guatemala: control de obras, presupuestos APU, planillas IGSS, firma digital de capataces y gestión de maquinaria. Funciona sin conexión para obra de campo.",
  "start_url": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "portrait-primary",
  "theme_color": "#0f172a",
  "background_color": "#0f172a",
  "id": "/",
  "scope": "/",
  "lang": "es",
  "dir": "ltr",
  "categories": ["productivity", "business", "finance", "construction"],
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "icons": [
