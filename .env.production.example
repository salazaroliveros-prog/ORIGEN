# ============================================================
# VARIABLES DE ENTORNO - ConstructERP Guatemala (Ejemplo)
# Copiar a .env.production y completar con valores reales
# Configurar en Vercel: Settings > Environment Variables
# ============================================================

# Gemini AI API
GEMINI_API_KEY=

# Google OAuth
NEXT_PUBLIC_FIREBASE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Firebase Configuration
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIRESTORE_DATABASE_ID=(default)

# Application
NEXT_PUBLIC_APP_NAME=ORIGEN
NEXT_PUBLIC_APP_URL=https://tu-dominio.vercel.app
NODE_ENV=production
PORT=3000
