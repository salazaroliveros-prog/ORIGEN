# Firebase Configuration (Required for Production)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your-measurement-id
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your-vapid-key
NEXT_PUBLIC_FIRESTORE_DATABASE_ID=(default)

# Gemini AI API (Required for AI Assistant)
GEMINI_API_KEY=your-gemini-api-key

# Security (Required for Production - configure en Vercel Dashboard, nunca commitear)
PRIMARY_ADMIN_EMAIL=tu-admin@ejemplo.com
DEFAULT_AUTH_EMAIL=
DEFAULT_AUTH_PASSWORD=tu-password-seguro
ALLOWED_ORIGINS=https://tu-dominio.com,https://tu-app.vercel.app

# Application Configuration
NEXT_PUBLIC_APP_NAME=ORIGEN ERP Web
NEXT_PUBLIC_APP_URL=https://your-domain.com
NODE_ENV=production
PORT=3000

# Optional: Firebase Emulators (Development Only)
# NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
# NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
