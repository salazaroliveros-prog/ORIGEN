# ORIGEN ERP - Variables de entorno
# Copia este archivo como .env.local para desarrollo.
# En producción (Vercel) configura las variables en el panel de Vercel;
# nunca commitees valores reales.

# --- Firebase (públicas, prefijo NEXT_PUBLIC_) ---
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIRESTORE_DATABASE_ID=
NEXT_PUBLIC_FIREBASE_APP_CHECK_RECAPTCHA_KEY=
NEXT_PUBLIC_FIREBASE_APP_CHECK_DEBUG_TOKEN=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# --- Servidor (sin prefijo; no se exponen al cliente) ---
GEMINI_API_KEY=
PRIMARY_ADMIN_EMAIL=
ALLOWED_ORIGINS=

# --- Opcionales ---
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_LOG_LEVEL=info
NEXT_PUBLIC_SENTRY_DSN=
