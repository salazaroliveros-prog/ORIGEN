NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=
NEXT_PUBLIC_FIRESTORE_DATABASE_ID=(default)
# Optional: set only when running a local Firestore Emulator, for example 127.0.0.1:8080
# NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=
# Optional: set only when running a local Firebase Authentication Emulator, for example 127.0.0.1:9099
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=

# Firebase App Check (opcional - requerido si App Check está habilitado en Firebase Console)
NEXT_PUBLIC_FIREBASE_APP_CHECK_DEBUG_TOKEN=
NEXT_PUBLIC_FIREBASE_APP_CHECK_RECAPTCHA_KEY=

# Gemini / AI
GEMINI_API_KEY=

