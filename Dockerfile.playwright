# Dockerfile for Playwright Testing
FROM mcr.microsoft.com/playwright:v1.65.0-jammy

WORKDIR /app

# Instalar Node.js
RUN apt-get update && apt-get install -y \
    curl \
    gnupg \
    && curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Copiar package files
COPY package.json package-lock.json ./

# Instalar dependencias (incluyendo dev dependencies con Playwright)
RUN npm ci

# Copiar código fuente
COPY . .

# Crear directorios para screenshots y resultados
RUN mkdir -p screenshots test-results

CMD ["npm", "run", "test:e2e:headed"]
