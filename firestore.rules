// ✅ FIRESTORE SECURITY RULES - ORIGEN ERP GUATEMALA
// Implementa: Autenticación, Autorización, Rate Limiting, Validación

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ✅ Funcion: Validar autenticación
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // ✅ Funcion: Validar propietario del documento
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // ✅ Funcion: Rate limiting (10 writes/min por usuario)
    function userWritesInLastMinute() {
      return firestore.query(query(
        collection('_audit_logs'),
        where('userId', '==', request.auth.uid),
        where('timestamp', '>', now - duration.value(60, 's'))
      )).size() < 10;
    }
    
    // ✅ Funcion: Validar estructura de documento
    function isValidProject() {
      return request.resource.data.keys().hasAll(['name', 'userId', 'createdAt']) &&
             request.resource.data.name is string &&
             request.resource.data.name.size() > 0 &&
             request.resource.data.name.size() < 200 &&
             request.resource.data.userId == request.auth.uid;
    }
    
    // ✅ PROYECTOS
    match /proyectos/{projectId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && 
                       isValidProject() && 
                       userWritesInLastMinute();
      allow update: if isAuthenticated() && 
                       isOwner(resource.data.userId) && 
                       userWritesInLastMinute();
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
      
      // ✅ Sub-colecciones de proyectos
      match /{document=**} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && userWritesInLastMinute();
      }
    }
    
    // ✅ APU (Análisis de Precios Unitarios)
    match /apu/{apuId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && userWritesInLastMinute();
      allow update: if isAuthenticated() && 
                       isOwner(resource.data.userId) && 
                       userWritesInLastMinute();
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }
    
    // ✅ GASTOS
    match /gastos/{gastoId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && userWritesInLastMinute();
      allow update: if isAuthenticated() && 
                       isOwner(resource.data.userId) && 
                       userWritesInLastMinute();
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }
    
    // ✅ PERSONAL
    match /personal/{personalId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && userWritesInLastMinute();
      allow update: if isAuthenticated() && 
                       isOwner(resource.data.userId) && 
                       userWritesInLastMinute();
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }
    
    // ✅ COTIZACIONES
    match /cotizaciones/{cotizacionId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && userWritesInLastMinute();
      allow update: if isAuthenticated() && 
                       isOwner(resource.data.userId) && 
                       userWritesInLastMinute();
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }
    
    // ✅ MAQUINARIA
    match /maquinaria/{maquinariaId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && userWritesInLastMinute();
      allow update: if isAuthenticated() && 
                       isOwner(resource.data.userId) && 
                       userWritesInLastMinute();
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }
    
    // ✅ ASISTENCIA
    match /asistencia/{asistenciaId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && userWritesInLastMinute();
      allow update: if isAuthenticated() && 
                       isOwner(resource.data.userId) && 
                       userWritesInLastMinute();
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }
    
    // ✅ USERS
    match /users/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && isOwner(userId);
      allow delete: if isAuthenticated() && isOwner(userId);
    }
    
    // ✅ AUDIT LOGS (Solo lectura interna)
    match /_audit_logs/{auditId} {
      allow read: if false; // Admin solo
      allow write: if false; // Admin solo
    }
    
    // ✅ EMPRESAS y MEMEBRÍAS
    match /companies/{companyId} {
      allow read: if isAuthenticated() && isOwner(resource.data.ownerId);
      allow create: if isAuthenticated() && isOwner(request.auth.uid);
      allow update: if isAuthenticated() && isOwner(resource.data.ownerId);
      allow delete: if isAuthenticated() && isOwner(resource.data.ownerId);
    }

    match /companies/{companyId}/members/{memberId} {
      allow read: if isAuthenticated() && isOwner(resource.data.uid);
      allow create: if isAuthenticated() && isOwner(request.auth.uid);
      allow update: if isAuthenticated() && isOwner(resource.data.uid);
      allow delete: if isAuthenticated() && isOwner(resource.data.uid);
    }

    // ✅ PROVEEDORES
    match /suppliers/{supplierId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update: if isAuthenticated() && isOwner(resource.data.userId);
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // ✅ BODEGAS
    match /warehouses/{warehouseId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update: if isAuthenticated() && isOwner(resource.data.userId);
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // ✅ ARTÍCULOS DE INVENTARIO
    match /inventoryItems/{itemId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update: if isAuthenticated() && isOwner(resource.data.userId);
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // ✅ MOVIMIENTOS DE INVENTARIO (solo transacciones autorizadas por la lógica de negocio)
    match /stockMovements/{movementId} {
      allow read: if isAuthenticated();
      allow write: if false; // Se controla vía transacciones en el servicio
    }

    // ✅ SALDOS DE INVENTARIO
    match /inventoryBalances/{balanceId} {
      allow read: if isAuthenticated();
      allow write: if false; // Se controla vía transacciones en el servicio
    }

    // ✅ ÓRDENES DE COMPRA
    match /purchaseOrders/{orderId} {
      allow read: if isAuthenticated() && isOwner(resource.data.requestedBy);
      allow create: if isAuthenticated() && isOwner(request.auth.uid);
      allow update: if isAuthenticated() && isOwner(resource.data.requestedBy);
      allow delete: if isAuthenticated() && isOwner(resource.data.requestedBy);
    }

    // ✅ SUBCONTRATOS
    match /subcontracts/{contractId} {
      allow read: if isAuthenticated() && isOwner(resource.data.createdBy);
      allow create: if isAuthenticated() && isOwner(request.auth.uid);
      allow update: if isAuthenticated() && isOwner(resource.data.createdBy);
      allow delete: if isAuthenticated() && isOwner(resource.data.createdBy);
    }

    // ✅ GASTOS
    match /expenses/{expenseId} {
      allow read: if isAuthenticated() && isOwner(resource.data.authorId);
      allow create: if isAuthenticated() && isOwner(request.auth.uid);
      allow update: if isAuthenticated() && isOwner(resource.data.authorId);
      allow delete: if isAuthenticated() && isOwner(resource.data.authorId);
    }

    // ✅ ASISTENCIA
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated() && isOwner(resource.data.authorId);
      allow create: if isAuthenticated() && isOwner(request.auth.uid);
      allow update: if isAuthenticated() && isOwner(resource.data.authorId);
      allow delete: if isAuthenticated() && isOwner(resource.data.authorId);
    }

    // ✅ EMPLEADOS
    match /employees/{employeeId} {
      allow read: if isAuthenticated() && isOwner(resource.data.createdBy);
      allow create: if isAuthenticated() && isOwner(request.auth.uid);
      allow update: if isAuthenticated() && isOwner(resource.data.createdBy);
      allow delete: if isAuthenticated() && isOwner(resource.data.createdBy);
    }

    // ✅ MAQUINARIA
    match /machinery/{machineryId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update: if isAuthenticated() && isOwner(resource.data.userId);
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // ✅ BITÁCORAS DE MAQUINARIA
    match /machineryLogs/{logId} {
      allow read: if isAuthenticated() && isOwner(resource.data.machineryId);
      allow create: if isAuthenticated() && isOwner(request.auth.uid);
      allow update: if isAuthenticated() && isOwner(resource.data.machineryId);
      allow delete: if isAuthenticated() && isOwner(resource.data.machineryId);
    }

    // ✅ COTIZACIONES
    match /quotes/{quoteId} {
      allow read: if isAuthenticated() && isOwner(resource.data.createdBy);
      allow create: if isAuthenticated() && isOwner(request.auth.uid);
      allow update: if isAuthenticated() && isOwner(resource.data.createdBy);
      allow delete: if isAuthenticated() && isOwner(resource.data.createdBy);
    }

    // ✅ PAGOS DE SUBCONTRATO
    match /subcontractPayments/{paymentId} {
      allow read: if isAuthenticated() && isOwner(resource.data.contractId);
      allow create: if isAuthenticated() && isOwner(request.auth.uid);
      allow update: if isAuthenticated() && isOwner(resource.data.contractId);
      allow delete: if isAuthenticated() && isOwner(resource.data.contractId);
    }

    // ✅ Por defecto: DENEGAR TODO documento no explícitamente cubierto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
