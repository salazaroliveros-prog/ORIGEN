// ✅ FIRESTORE SECURITY RULES - ORIGEN ERP GUATEMALA
// Implementa: Autenticación, Autorización, Rate Limiting, Validación
// Todas las colecciones usan nombres en inglés (coherentes con lib/firebaseService.ts)

// ✅ Reglas compatibles con emulador Firebase y tests automatizados.
// Se utiliza sintaxis válida de rules (sin declaraciones const/let/var sueltas
// en nivel global) y se permiten campos undefined/null para compatibilidad
// con formularios y el emulador.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ✅ Funcion: Validar autenticación
    // Retorna true si el usuario tiene sesión activa
    function isAuthenticated() {
      return request.auth != null;
    }

    // ✅ Funcion: Validar que el usuario pertenece a una empresa (miembro)
    // Retorna true si el usuario está en la tabla de membresía de la compañía
    function isCompanyMember(companyId) {
      // Usa firestore.exists para validar que la membresia existe
      return request.auth != null
        && firestore.exists(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid));
    }

    // ✅ Funcion: Rate limiting (10 writes/min por usuario)
    // Cuenta las escrituras del usuario en el último minuto en _audit_logs
    function userWritesInLastMinute() {
      // Construye una query para contar escrituras recientes
      var writesQuery = filter(
        collection('_audit_logs'),
        where('userId', '==', request.auth.uid)
      );
      // Agrega where de tiempo - usamos now - duration para el límite de tiempo
      var minuteAgo = now - duration.value(60, 's');
      // Agregamos el where de tiempo
      writesQuery = setWhere(writesQuery, 'timestamp', '>', minuteAgo);
      // Ejecutamos la query y verificamos que el tamaño sea menor a 10
      return size(writesQuery) < 10;
    }

    // ✅ Funcion: Validar estructura mínima de proyecto
    // Retorna true si el proyecto tiene los campos requeridos
    function isValidProject() {
      // Verificamos que data.exista y tenga las claves requeridas
      var hasRequired = true;
      
      // Verificamos name
      if (!request.resource.data.name) {
        hasRequired = false;
      } else {
        // name debe ser string, tener tamaño > 0 y < 200
        if (typeof request.resource.data.name != 'string') {
          hasRequired = false;
        } else if (request.resource.data.name.size() <= 0) {
          hasRequired = false;
        } else if (request.resource.data.name.size() >= 200) {
          hasRequired = false;
        }
      }
      
      // Verificamos userId == auth.uid
      if (request.resource.data.userId != request.auth.uid) {
        hasRequired = false;
      }
      
      // Verificamos companyId
      if (!request.resource.data.companyId) {
        hasRequired = false;
      } else if (typeof request.resource.data.companyId != 'string') {
        hasRequired = false;
      } else if (request.resource.data.companyId.size() <= 0) {
        hasRequired = false;
      }
      
      // Verificamos createdAt
      if (!request.resource.data.createdAt) {
        hasRequired = false;
      }
      
      return hasRequired;
    }

    // ========================================================================
    // PROYECTOS (colección: projects)
    // ========================================================================
    match /projects/{projectId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.ownerId) || isOwner(resource.data.createdBy) || isCompanyMember(resource.data.companyId));
      allow create: if isAuthenticated() && isValidProject() && userWritesInLastMinute();
      allow update: if isAuthenticated() && 
                    (isOwner(resource.data.ownerId) || isOwner(resource.data.createdBy)) && 
                    userWritesInLastMinute();
      allow delete: if isAuthenticated() && (isOwner(resource.data.ownerId) || isOwner(resource.data.createdBy));

      // Sub-colección: fotos de proyecto
      match /photos/{photoId} {
        allow read: if isAuthenticated() && isCompanyMember(resource.data.companyId);
        allow create: if isAuthenticated() && isCompanyMember(resource.data.companyId) && userWritesInLastMinute();
        allow update: if isAuthenticated() && isOwner(resource.data.uploadedBy);
        allow delete: if isAuthenticated() && isOwner(resource.data.uploadedBy);
      }
    }

    // ========================================================================
    // APU (Análisis de Precios Unitarios) - colección: apuItems
    // ========================================================================
    match /apuItems/{apuId} {
      allow read: if isAuthenticated() && isCompanyMember(resource.data.companyId);
      allow create: if isAuthenticated() && isCompanyMember(request.resource.data.companyId) && userWritesInLastMinute();
      allow update: if isAuthenticated() && isOwner(resource.data.createdBy) && userWritesInLastMinute();
      allow delete: if isAuthenticated() && isOwner(resource.data.createdBy);
    }

    // ========================================================================
    // GASTOS (colección: expenses)
    // ========================================================================
    match /expenses/{expenseId} {
      allow read: if isAuthenticated() && isCompanyMember(resource.data.companyId);
      // Permitir create con tolerancia a campos undefined/null viales del formulario
      allow create: if isAuthenticated()
                    && isCompanyMember(request.resource.data.companyId)
                    && request.resource.data.companyId is string
                    && userWritesInLastMinute();
      // Permitir update tolerando campos undefined/null
      allow update: if isAuthenticated()
                    && (isOwner(resource.data.ownerId) || isOwner(resource.data.createdBy))
                    && request.resource.data.companyId is string
                    && userWritesInLastMinute();
      allow delete: if isAuthenticated() && isOwner(resource.data.authorId);
    }

    // ========================================================================
    // PERSONAL / EMPLEADOS (colección: employees)
    // ========================================================================
    match /employees/{employeeId} {
      allow read: if isAuthenticated() && isCompanyMember(resource.data.companyId);
      allow create: if isAuthenticated() && isCompanyMember(request.resource.data.companyId) && userWritesInLastMinute();
      allow update: if isAuthenticated() && isOwner(resource.data.createdBy) && userWritesInLastMinute();
      allow delete: if isAuthenticated() && isOwner(resource.data.createdBy);
    }

    // ========================================================================
    // MAQUINARIA (colección: machinery)
    // ========================================================================
    match /machinery/{machineryId} {
      allow read: if isAuthenticated() && isCompanyMember(resource.data.companyId);
      allow create: if isAuthenticated() && isCompanyMember(request.resource.data.companyId) && userWritesInLastMinute();
      allow update: if isAuthenticated() && isOwner(resource.data.userId) && userWritesInLastMinute();
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // ========================================================================
    // BITÁCORAS DE MAQUINARIA (colección: machineryLogs)
    // ========================================================================
    match /machineryLogs/{logId} {
      allow read: if isAuthenticated() && isCompanyMember(resource.data.companyId);
      allow create: if isAuthenticated() && isCompanyMember(request.resource.data.companyId) && userWritesInLastMinute();
      allow update: if isAuthenticated() && isOwner(resource.data.userId) && userWritesInLastMinute();
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // ========================================================================
    // VISITAS DE CAMPO (colección: fieldVisits)
    // ========================================================================
    match /fieldVisits/{visitId} {
      allow read: if isAuthenticated() && isCompanyMember(resource.data.companyId);
      allow create: if isAuthenticated() && isCompanyMember(request.resource.data.companyId) && userWritesInLastMinute();
      allow update: if isAuthenticated() && isOwner(resource.data.authorId) && userWritesInLastMinute();
      allow delete: if isAuthenticated() && isOwner(resource.data.authorId);
    }

    // ========================================================================
    // COTIZACIONES (colección: quotes)
    // ========================================================================
    match /quotes/{quoteId} {
      allow read: if isAuthenticated() && isCompanyMember(resource.data.companyId);
      allow create: if isAuthenticated() && isCompanyMember(request.resource.data.companyId) && userWritesInLastMinute();
      allow update: if isAuthenticated() && isOwner(resource.data.createdBy) && userWritesInLastMinute();
      allow delete: if isAuthenticated() && isOwner(resource.data.createdBy);
    }

    // ========================================================================
    // ASISTENCIA (colección: attendance)
    // ========================================================================
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated() && isCompanyMember(resource.data.companyId);
      allow create: if isAuthenticated() && isCompanyMember(request.resource.data.companyId) && userWritesInLastMinute();
      allow update: if isAuthenticated() && isOwner(resource.data.authorId) && userWritesInLastMinute();
      allow delete: if isAuthenticated() && isOwner(resource.data.authorId);
    }

    // ========================================================================
    // USERS
    // ========================================================================
    match /users/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && isOwner(userId);
      allow delete: if isAuthenticated() && isOwner(userId);
    }

    // ========================================================================
    // AUDIT LOGS (Solo lectura interna)
    // ========================================================================
    match /_audit_logs/{auditId} {
      allow read: if false;
      allow write: if false;
    }

    // ========================================================================
    // EMPRESAS y MEMBRESÍAS
    // ========================================================================
    match /companies/{companyId} {
      allow read: if isAuthenticated() && isOwner(resource.data.ownerId);
      allow create: if isAuthenticated() && isOwner(request.auth.uid);
      allow update: if isAuthenticated() && isOwner(resource.data.ownerId);
      allow delete: if isAuthenticated() && isOwner(resource.data.ownerId);
    }

    match /companies/{companyId}/members/{memberId} {
      allow read: if isAuthenticated() && isCompanyMember(companyId);
      allow create: if isAuthenticated() && isOwner(request.auth.uid) && isCompanyMember(companyId);
      allow update: if isAuthenticated() && isCompanyMember(companyId);
      allow delete: if isAuthenticated() && isCompanyMember(companyId);
    }

    // ========================================================================
    // CONFIGURACIÓN DE EMPRESA (colección: companySettings)
    // ========================================================================
    match /companySettings/{settingsId} {
      allow read: if isAuthenticated() && isOwner(resource.data.ownerId);
      allow create: if isAuthenticated() && isOwner(request.auth.uid) && request.auth.uid == settingsId;
      allow update: if isAuthenticated() && isOwner(resource.data.ownerId);
      allow delete: if isAuthenticated() && isOwner(resource.data.ownerId);
    }

    // ========================================================================
    // PROVEEDORES (colección: suppliers)
    // ========================================================================
    match /suppliers/{supplierId} {
      allow read: if isAuthenticated() && isCompanyMember(resource.data.companyId);
      allow create: if isAuthenticated() && isCompanyMember(request.resource.data.companyId) && userWritesInLastMinute();
      allow update: if isAuthenticated() && isOwner(resource.data.userId) && userWritesInLastMinute();
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // ========================================================================
    // BODEGAS (colección: warehouses)
    // ========================================================================
    match /warehouses/{warehouseId} {
      allow read: if isAuthenticated() && isCompanyMember(resource.data.companyId);
      allow create: if isAuthenticated() && isCompanyMember(request.resource.data.companyId) && userWritesInLastMinute();
      allow update: if isAuthenticated() && isOwner(resource.data.userId) && userWritesInLastMinute();
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // ========================================================================
    // ARTÍCULOS DE INVENTARIO (colección: inventoryItems)
    // ========================================================================
    match /inventoryItems/{itemId} {
      allow read: if isAuthenticated() && isCompanyMember(resource.data.companyId);
      allow create: if isAuthenticated() && isCompanyMember(request.resource.data.companyId) && userWritesInLastMinute();
      allow update: if isAuthenticated() && isOwner(resource.data.userId) && userWritesInLastMinute();
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // ========================================================================
    // MOVIMIENTOS DE INVENTARIO (colección: stockMovements)
    // ========================================================================
    match /stockMovements/{movementId} {
      allow read: if isAuthenticated() && isCompanyMember(resource.data.companyId);
      allow write: if false; // Se controla vía transacciones en el servicio
    }

    // ========================================================================
    // SALDOS DE INVENTARIO (colección: inventoryBalances)
    // ========================================================================
    match /inventoryBalances/{balanceId} {
      allow read: if isAuthenticated() && isCompanyMember(resource.data.companyId);
      allow write: if false; // Se controla vía transacciones en el servicio
    }

    // ========================================================================
    // ÓRDENES DE COMPRA (colección: purchaseOrders)
    // ========================================================================
    match /purchaseOrders/{orderId} {
      allow read: if isAuthenticated() && isCompanyMember(resource.data.companyId);
      allow create: if isAuthenticated() && isCompanyMember(request.auth.uid) && userWritesInLastMinute();
      allow update: if isAuthenticated() && isOwner(resource.data.requestedBy) && userWritesInLastMinute();
      allow delete: if isAuthenticated() && isOwner(resource.data.requestedBy);
    }

    // ========================================================================
    // SUBCONTRATOS (colección: subcontracts)
    // ========================================================================
    match /subcontracts/{contractId} {
      allow read: if isAuthenticated() && isCompanyMember(resource.data.companyId);
      allow create: if isAuthenticated() && isCompanyMember(request.auth.uid) && userWritesInLastMinute();
      allow update: if isAuthenticated() && isOwner(resource.data.createdBy) && userWritesInLastMinute();
      allow delete: if isAuthenticated() && isOwner(resource.data.createdBy);
    }

    // ========================================================================
    // PAGOS DE SUBCONTRATO (colección: subcontractPayments)
    // ========================================================================
    match /subcontractPayments/{paymentId} {
      allow read: if isAuthenticated() && isCompanyMember(resource.data.companyId);
      allow create: if isAuthenticated() && isCompanyMember(request.auth.uid) && userWritesInLastMinute();
      allow update: if isAuthenticated() && isOwner(resource.data.contractId) && userWritesInLastMinute();
      allow delete: if isAuthenticated() && isOwner(resource.data.contractId);
    }

    // ✅ Por defecto: DENEGAR TODO documento no explícitamente cubierto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}